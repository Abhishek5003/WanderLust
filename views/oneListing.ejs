<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= listing.title %></title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, Helvetica, sans-serif;
      }

      body {
        background: #f5f5f5;
        display: flex;
        justify-content: center;
        padding: 40px;
      }

      .card {
        width: 850px;
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
      }

      .card img {
        width: 100%;
        height: 450px;
        object-fit: cover;
      }

      .card-body {
        padding: 30px;
      }

      .title {
        font-size: 2rem;
        color: #222;
        margin-bottom: 15px;
      }

      .description {
        color: #555;
        line-height: 1.7;
        font-size: 1.05rem;
        margin-bottom: 25px;
      }

      .btn {
        border: none;
        cursor: pointer;
      }

      .price {
        font-size: 1.8rem;
        color: #ff385c;
        font-weight: bold;
        margin-bottom: 20px;
      }

      .location {
        font-size: 1.1rem;
        color: #666;
        margin-bottom: 12px;
      }

      .country {
        font-size: 1.1rem;
        color: #666;
        margin-bottom: 25px;
      }

      .id {
        color: gray;
        font-size: 14px;
        border-top: 1px solid #ddd;
        padding-top: 20px;
      }

      .btn {
        display: inline-block;
        margin-top: 25px;
        padding: 12px 22px;
        background: #ff385c;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: bold;
        transition: 0.3s;
      }

      .btn:hover {
        background: #e11d48;
      }
    </style>
  </head>

  <body>
    <div class="card">
      <img src="<%= listing.image %>" alt="<%= listing.title %>" />

      <div class="card-body">
        <h1 class="title"><%= listing.title %></h1>

        <p class="description"><%= listing.description %></p>

        <p class="price">₹<%= listing.price %> / night</p>

        <p class="location">
          📍 <strong>Location:</strong> <%= listing.location %>
        </p>

        <p class="country">
          🌍 <strong>Country:</strong> <%= listing.country %>
        </p>

        <p class="id">Listing ID: <%= listing.id %></p>

        <a href="/listings" class="btn">← Back to Listings</a>
        <a href="/listings/<%= listing._id %>/edit" class="btn">
          Edit Listing
        </a>
        <form
          action="/listings/<%= listing._id %>?_method=DELETE"
          method="POST"
          style="display: inline"
        >
          <button class="btn">Delete Listing</button>
        </form>
      </div>
    </div>
  </body>
</html>
