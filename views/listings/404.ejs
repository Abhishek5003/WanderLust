      </div>

      <!-- Copy & Text -->
      <h2 class="sub-heading">
        <%= typeof subtitle !== 'undefined' ? subtitle : 'Lost Traveler?' %>
      </h2>
      <h1 class="main-heading">
        <%= typeof title !== 'undefined' ? title : "This page can't be found"
        %><span class="dot">.</span>
      </h1>

      <p class="description">
        Looks like you've wandered off the map.<br />
        The destination you're looking for doesn't exist.
      </p>

      <!-- Glass Divider -->
      <div class="divider">
        <span class="dashed-line"></span>
        <i class="fa-solid fa-magnifying-glass search-icon"></i>
        <span class="dashed-line"></span>
      </div>

      <!-- Action Buttons -->
      <div class="actions">
        <a
          href="<%= typeof homeUrl !== 'undefined' ? homeUrl : '/' %>"
          class="btn btn-red"
        >
          <i class="fa-solid fa-house"></i> Back to Home
        </a>
        <a
          href="<%= typeof browseUrl !== 'undefined' ? browseUrl : '/listings' %>"
          class="btn btn-outline"
        >
          <i class="fa-regular fa-compass"></i> Browse Listings
        </a>
      </div>

      <!-- Pin Point -->
      <div class="location-marker">
        <i class="fa-solid fa-location-dot"></i>
      </div>
    </main>
  </body>
</html>
