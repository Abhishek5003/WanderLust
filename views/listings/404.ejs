<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 - Page Not Found</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Plus+Jakarta+Sans:wght@500;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <style>
      :root {
        --bg-color: #fbfcfd;
        --primary-red: #e63854;
        --primary-hover: #d02e47;
        --navy-dark: #fefefe;
        --text-muted: #a6b7cd;
        --border-dark: #1e2738;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Plus Jakarta Sans", sans-serif;

        min-height: 100vh;

        display: flex;

        justify-content: center;

        align-items: center;

        padding: 40px 20px;

        overflow-x: hidden;
      }

      body {
        background: linear-gradient(135deg, #202938, #29384e, #354b69);
      }
      /* Scaled wrapper for ~12-15% extra zoom */
      .error-card {
        max-width: 1080px;
        width: 100%;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        transform: scale(1.22); /* Zoomed in another ~14% */
        transform-origin: center center;
        margin: 40px 0;
      }

      /* Zoomed SVG Container */
      .graphic-container {
        width: 100%;
        max-width: 980px;
        margin-bottom: 5px;
      }

      .graphic-container svg {
        width: 100%;
        height: auto;
        display: block;
      }

      /* Handwritten Subtitle */
      .sub-heading {
        font-family: "Caveat", cursive;
        color: var(--primary-red);
        font-size: 2.9rem;
        font-weight: 600;
        margin-bottom: 2px;
        letter-spacing: -0.3px;
      }

      /* Main Heading */
      .main-heading {
        font-size: 2.7rem;
        font-weight: 800;
        color: var(--navy-dark);
        margin-bottom: 14px;
        letter-spacing: -0.5px;
      }

      .main-heading .dot {
        color: var(--primary-red);
      }

      /* Description Body */
      .description {
        color: var(--text-muted);
        font-size: 1.1rem;
        line-height: 1.6;
        margin-bottom: 24px;
        font-weight: 500;
      }

      /* Divider with Magnifier */
      .divider {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 30px;
      }

      .dashed-line {
        width: 52px;
        height: 1px;
        border-bottom: 1.5px dashed #f5a3b0;
      }

      .search-icon {
        color: var(--primary-red);
        font-size: 1.05rem;
      }

      /* Action Buttons */
      .actions {
        display: flex;
        gap: 16px;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 32px;
        border-radius: 8px;
        font-size: 1.05rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
      }

      .btn-red {
        background-color: var(--primary-red);
        color: #ffffff;
        border: 2px solid var(--primary-red);
        box-shadow: 0 4px 14px rgba(230, 56, 84, 0.25);
      }

      .btn-red:hover {
        background-color: var(--primary-hover);
        border-color: var(--primary-hover);
        transform: translateY(-2px);
      }

      .btn-outline {
        background-color: transparent;
        color: var(--navy-dark);
        border: 2px solid var(--navy-dark);
      }

      .btn-outline:hover {
        background-color: var(--navy-dark);
        color: #ffffff;
        transform: translateY(-2px);
      }

      /* Pin Marker */
      .location-marker {
        margin-top: 22px;
        color: var(--primary-red);
        font-size: 1.85rem;
      }

      @media (max-width: 900px) {
        .error-card {
          transform: scale(
            1
          ); /* Reset zoom on tablets and mobile to avoid clipping */
          margin: 0;
        }
        .sub-heading {
          font-size: 2.2rem;
        }
        .main-heading {
          font-size: 1.9rem;
        }
        .actions {
          flex-direction: column;
          width: 100%;
        }
        .btn {
          width: 100%;
          max-width: 280px;
          justify-content: center;
        }
      }
    </style>
  </head>
  <body>
